  "source_files_mapping": {
    "original_to_wordpress": [
      { "from": "js/main.js", "to": "public/js/game/main.js", "modifications": ["Remove Google Analytics", "Remove AdSense", "Add WP hooks"] },
      { "from": "js/initialization.js", "to": "public/js/game/initialization.js", "modifications": ["Replace jQuery with vanilla JS or wp.dom", "Add settings injection from WP"] },
      { "from": "js/Block.js", "to": "public/js/game/Block.js", "modifications": ["None - pure game logic"] },
      { "from": "js/Hex.js", "to": "public/js/game/Hex.js", "modifications": ["None - pure game logic"] },
      { "from": "js/view.js", "to": "public/js/game/view.js", "modifications": ["Remove social sharing buttons", "Add WP-native sharing hooks"] },
      { "from": "js/update.js", "to": "public/js/game/update.js", "modifications": ["None - pure game logic"] },
      { "from": "js/render.js", "to": "public/js/game/render.js", "modifications": ["None - pure game logic"] },
      { "from": "js/input.js", "to": "public/js/game/input.js", "modifications": ["Namespace event listeners to prevent conflicts"] },
      { "from": "js/checking.js", "to": "public/js/game/checking.js", "modifications": ["None - pure game logic"] },
      { "from": "js/wavegen.js", "to": "public/js/game/wavegen.js", "modifications": ["None - pure game logic"] },
      { "from": "js/save-state.js", "to": "public/js/game/save-state.js", "modifications": ["Add optional server-side score sync", "Namespace localStorage keys"] },
      { "from": "js/comboTimer.js", "to": "public/js/game/comboTimer.js", "modifications": ["None - pure game logic"] },
      { "from": "js/Text.js", "to": "public/js/game/Text.js", "modifications": ["None - pure game logic"] },
      { "from": "js/math.js", "to": "public/js/game/math.js", "modifications": ["None - pure utilities"] },
      { "from": "style/style.css", "to": "public/css/hextris-public.css", "modifications": ["Scope all selectors under .hextris-container", "Remove body/html resets", "Remove Google Fonts link (use wp_enqueue)"] },
      { "from": "vendor/hammer.min.js", "to": "public/js/vendor/hammer.min.js", "modifications": ["None - third party"] },
      { "from": "vendor/keypress.min.js", "to": "public/js/vendor/keypress.min.js", "modifications": ["None - third party"] },
      { "from": "images/*.svg", "to": "public/images/", "modifications": ["None - assets"] }
    ],
    "files_to_remove": [
      "vendor/jquery.js (use WordPress bundled jQuery)",
      "vendor/js.cookie.js (use native localStorage)",
      "vendor/sweet-alert.min.js (optional, or use WP modals)",
      "vendor/rrssb.min.js (replace with WP sharing)",
      "style/rrssb.css (not needed)",
      "style/fa/ (use WordPress Dashicons or bundle separately)",
      "Google Analytics code blocks",
      "Google AdSense code blocks",
      "App store badges and mobile app references"
    ]
  },

  "shortcode": {
    "tag": "hextris",
    "attributes": {
      "width": { "type": "string", "default": "100%", "description": "Container width (px, %, vw)" },
      "height": { "type": "string", "default": "600px", "description": "Container height (px, vh)" },
      "max_width": { "type": "string", "default": "800px", "description": "Maximum width constraint" },
      "theme": { "type": "string", "default": "default", "description": "Color theme: default, dark, colorblind" },
      "difficulty": { "type": "string", "default": "normal", "description": "Starting difficulty: easy, normal, hard" },
      "show_leaderboard": { "type": "boolean", "default": true, "description": "Display high scores" },
      "enable_sound": { "type": "boolean", "default": false, "description": "Enable sound effects (future)" },
      "user_scores": { "type": "boolean", "default": false, "description": "Track logged-in user scores" }
    },
    "example_usage": [
      "[hextris]",
      "[hextris width=\"600px\" height=\"800px\"]",
      "[hextris theme=\"colorblind\" difficulty=\"easy\"]",
      "[hextris show_leaderboard=\"false\" max_width=\"500px\"]"
    ],
    "output_html": "<div class=\"hextris-container\" id=\"hextris-{unique_id}\" data-settings=\"{json_settings}\"><canvas id=\"hextris-canvas-{unique_id}\"></canvas><div class=\"hextris-ui\"><!-- UI elements --></div></div>"
  },

  "gutenberg_block": {
    "name": "hextris-arcade/game",
    "title": "Hextris Game",
    "category": "embed",
    "icon": "games",
    "attributes": {
      "width": { "type": "string", "default": "100%" },
      "height": { "type": "string", "default": "600px" },
      "maxWidth": { "type": "string", "default": "800px" },
      "theme": { "type": "string", "default": "default" },
      "difficulty": { "type": "string", "default": "normal" },
      "showLeaderboard": { "type": "boolean", "default": true },
      "alignment": { "type": "string", "default": "center" }
    },
    "supports": {
      "align": ["wide", "full", "center"],
      "html": false
    },
    "editor_preview": "Static placeholder with play button overlay"
  },

  "admin_settings": {
    "menu_location": "Settings > Hextris Arcade",
    "capability": "manage_options",
    "option_group": "hextris_settings",
    "sections": {
      "general": {
        "title": "General Settings",
        "fields": {
          "default_width": { "type": "text", "default": "100%", "label": "Default Width" },
          "default_height": { "type": "text", "default": "600px", "label": "Default Height" },
          "default_max_width": { "type": "text", "default": "800px", "label": "Default Max Width" }
        }
      },
      "gameplay": {
        "title": "Gameplay Settings",
        "fields": {
          "default_difficulty": { "type": "select", "options": ["easy", "normal", "hard"], "default": "normal", "label": "Default Difficulty" },
          "speed_modifier": { "type": "range", "min": 0.3, "max": 1.5, "step": 0.05, "default": 0.65, "label": "Speed Modifier" },
          "combo_time_ms": { "type": "number", "min": 100, "max": 1000, "default": 310, "label": "Combo Window (ms)" },
          "max_rows": { "type": "number", "min": 5, "max": 12, "default": 8, "label": "Max Block Rows" }
        }
      },
      "appearance": {
        "title": "Appearance",
        "fields": {
          "color_scheme": { "type": "select", "options": ["default", "dark", "colorblind", "custom"], "default": "default", "label": "Color Scheme" },
          "custom_colors": {
            "type": "color_group",
            "colors": {
              "color_1": { "default": "#e74c3c", "label": "Color 1 (Red)" },
              "color_2": { "default": "#f1c40f", "label": "Color 2 (Yellow)" },
              "color_3": { "default": "#3498db", "label": "Color 3 (Blue)" },
              "color_4": { "default": "#2ecc71", "label": "Color 4 (Green)" },
              "background": { "default": "#ecf0f1", "label": "Background" },
              "hexagon_fill": { "default": "#2c3e50", "label": "Hexagon Fill" }
            }
          },
          "show_combo_timer": { "type": "checkbox", "default": true, "label": "Show Combo Timer" }
        }
      },
      "leaderboard": {
        "title": "Leaderboard Settings",
        "fields": {
          "enable_global_leaderboard": { "type": "checkbox", "default": true, "label": "Enable Global Leaderboard" },
          "scores_to_display": { "type": "number", "min": 3, "max": 20, "default": 10, "label": "Scores to Display" },
          "track_user_scores": { "type": "checkbox", "default": true, "label": "Track Logged-in User Scores" },
          "allow_anonymous_scores": { "type": "checkbox", "default": true, "label": "Allow Anonymous Scores" }
        }
      },
      "advanced": {
        "title": "Advanced",
        "fields": {
          "load_scripts_globally": { "type": "checkbox", "default": false, "label": "Load Scripts on All Pages" },
          "defer_scripts": { "type": "checkbox", "default": true, "label": "Defer Script Loading" },
          "enable_debug_mode": { "type": "checkbox", "default": false, "label": "Enable Debug Mode" }
        }
      }
    }
  },

  "database": {
    "tables": {
      "hextris_scores": {
        "columns": {
          "id": "BIGINT(20) UNSIGNED NOT NULL AUTO_INCREMENT PRIMARY KEY",
          "user_id": "BIGINT(20) UNSIGNED DEFAULT NULL (FK to wp_users)",
          "player_name": "VARCHAR(100) DEFAULT 'Anonymous'",
          "score": "INT(11) UNSIGNED NOT NULL",
          "difficulty": "VARCHAR(20) DEFAULT 'normal'",
          "game_duration": "INT(11) UNSIGNED DEFAULT 0 (seconds)",
          "max_combo": "INT(11) UNSIGNED DEFAULT 0",
          "blocks_cleared": "INT(11) UNSIGNED DEFAULT 0",
          "ip_hash": "VARCHAR(64) DEFAULT NULL (privacy-safe)",
          "created_at": "DATETIME DEFAULT CURRENT_TIMESTAMP",
          "user_agent": "VARCHAR(255) DEFAULT NULL"
        },
        "indexes": [
          "INDEX idx_score (score DESC)",
          "INDEX idx_user_id (user_id)",
          "INDEX idx_created_at (created_at)",
          "INDEX idx_difficulty (difficulty)"
        ]
      }
    },
    "options": {
      "hextris_settings": "Serialized plugin settings array",
      "hextris_db_version": "Database schema version for migrations"
    }
  },

  "rest_api": {
    "namespace": "hextris/v1",
    "endpoints": [
      {
        "route": "/scores",
        "methods": ["GET"],
        "permission": "public",
        "params": {
          "limit": { "type": "integer", "default": 10, "max": 100 },
          "offset": { "type": "integer", "default": 0 },
          "difficulty": { "type": "string", "enum": ["easy", "normal", "hard", "all"] },
          "period": { "type": "string", "enum": ["all", "day", "week", "month"] }
        },
        "response": {
          "scores": "array of score objects",
          "total": "total count for pagination"
        }
      },
      {
        "route": "/scores",
        "methods": ["POST"],
        "permission": "nonce_verified",
        "params": {
          "score": { "type": "integer", "required": true },
          "player_name": { "type": "string", "max_length": 100 },
          "difficulty": { "type": "string" },
          "game_duration": { "type": "integer" },
          "max_combo": { "type": "integer" },
          "blocks_cleared": { "type": "integer" }
        },
        "validation": ["Rate limiting: 1 score per 10 seconds per IP", "Score sanity check: max 1,000,000"],
        "response": {
          "success": "boolean",
          "rank": "position in leaderboard",
          "score_id": "inserted record ID"
        }
      },
      {
        "route": "/scores/user",
        "methods": ["GET"],
        "permission": "logged_in",
        "response": {
          "scores": "array of user's scores",
          "best_score": "highest score",
          "total_games": "games played count"
        }
      },
      {
        "route": "/settings",
        "methods": ["GET"],
        "permission": "public",
        "response": "Public game settings for frontend initialization"
      }
    ]
  },

