  "code_modifications": {
    "remove_jquery_dependency": {
      "description": "Replace jQuery with vanilla JS or WordPress wp.dom utilities",
      "files_affected": ["initialization.js", "input.js", "view.js", "main.js"],
      "jquery_usages_to_replace": [
        "$(document).ready() → DOMContentLoaded event",
        "$(selector) → document.querySelector/querySelectorAll",
        "$.each() → Array.forEach or for...of",
        ".css() → element.style or classList",
        ".addClass/.removeClass → classList.add/remove",
        ".attr() → getAttribute/setAttribute",
        ".on() → addEventListener"
      ]
    },
    "namespace_globals": {
      "description": "Wrap all game code in IIFE or module to prevent global pollution",
      "pattern": "(function(window, document, undefined) { /* game code */ })(window, document);",
      "export": "window.HextrisGame = { init, destroy, pause, resume, getScore }"
    },
    "scope_css_selectors": {
      "description": "Prefix all CSS selectors to prevent theme conflicts",
      "prefix": ".hextris-container",
      "examples": [
        "#canvas → .hextris-container #hextris-canvas",
        "#startBtn → .hextris-container .hextris-start-btn",
        "body reset rules → Remove entirely"
      ]
    },
    "multiple_instances": {
      "description": "Support multiple game instances on same page",
      "changes": [
        "Replace global variables with instance properties",
        "Use unique IDs per instance (hextris-canvas-{uid})",
        "Store instance references in WeakMap",
        "Clean up event listeners on destroy"
      ]
    },
    "localstorage_namespacing": {
      "description": "Namespace localStorage keys to avoid conflicts",
      "pattern": "hextris_{site_id}_{key}",
      "keys": ["saveState", "highscores", "settings"]
    }
  },

